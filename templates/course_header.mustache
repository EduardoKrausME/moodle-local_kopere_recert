{{!
    @template local_kopere_recert/course_header

    Example context (json):
    {
        "courseurl": "/local/kopere_recert/course.php?courseid=10",
        "noticesurl": "/local/kopere_recert/notices.php?courseid=10",
        "noticescount": 3,
        "bulkurl": "/local/kopere_recert/bulk.php?courseid=10",
        "historyurl": "/local/kopere_recert/history.php?courseid=10",
        "tasksurl": "/local/kopere_recert/tasks.php?courseid=10",
        "courseactive": true,
        "noticesactive": false,
        "bulkactive": false,
        "historyactive": false,
        "tasksactive": false
    }
}}

<nav class="mb-4" aria-label="{{#str}}courseconfiguration, local_kopere_recert{{/str}}">
    <div class="nav nav-tabs">
        <a class="nav-link{{#courseactive}} active{{/courseactive}}"
           href="{{courseurl}}"{{#courseactive}} aria-current="page"{{/courseactive}}>
            {{#str}}courseconfiguration, local_kopere_recert{{/str}}
        </a>
        <a class="nav-link{{#noticesactive}} active{{/noticesactive}}"
           href="{{noticesurl}}"{{#noticesactive}} aria-current="page"{{/noticesactive}}>
            {{#str}}notices, local_kopere_recert{{/str}} ({{noticescount}})
        </a>
        <a class="nav-link{{#bulkactive}} active{{/bulkactive}}"
           href="{{bulkurl}}"{{#bulkactive}} aria-current="page"{{/bulkactive}}>
            {{#str}}bulkkopere_recert, local_kopere_recert{{/str}}
        </a>
        <a class="nav-link{{#historyactive}} active{{/historyactive}}"
           href="{{historyurl}}"{{#historyactive}} aria-current="page"{{/historyactive}}>
            {{#str}}history, local_kopere_recert{{/str}}
        </a>
        <a class="nav-link{{#tasksactive}} active{{/tasksactive}}"
           href="{{tasksurl}}"{{#tasksactive}} aria-current="page"{{/tasksactive}}>
            {{#str}}tasks, local_kopere_recert{{/str}}
        </a>
    </div>
</nav>
