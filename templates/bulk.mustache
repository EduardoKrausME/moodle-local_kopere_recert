{{!
    @template local_kopere_recertification/bulk

    Example context (json):
    {
        "courseid": 10,
        "search": "Eduardo",
        "sesskey": "example-session-key",
        "users": [
            {
                "id": 42,
                "fullname": "Eduardo Kraus",
                "email": "eduardo@example.com"
            }
        ]
    }
}}

<form method="get" class="mb-3">
    <input type="hidden" name="courseid" value="{{courseid}}">
    <div class="input-group">
        <input class="form-control" type="search" name="search" value="{{search}}" placeholder="{{#str}}search{{/str}}">
        <button class="btn btn-secondary" type="submit">{{#str}}search{{/str}}</button>
    </div>
</form>

<form method="post">
    <input type="hidden" name="courseid" value="{{courseid}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <div class="mb-3">
        <label for="bulk-reason" class="form-label">{{#str}}reason, local_kopere_recertification{{/str}}</label>
        <input id="bulk-reason" class="form-control" name="reason" required>
    </div>
    <div class="table-responsive">
    <table class="table generaltable">
        <thead><tr><th></th><th>{{#str}}fullname{{/str}}</th><th>{{#str}}email{{/str}}</th></tr></thead>
        <tbody>
        {{#users}}<tr><td><input type="checkbox" name="userids[]" value="{{id}}"></td><td>{{fullname}}</td><td>{{email}}</td></tr>{{/users}}
        </tbody>
    </table>
    </div>
    <button class="btn btn-primary" type="submit">{{#str}}recertifyselected, local_kopere_recertification{{/str}}</button>
</form>
