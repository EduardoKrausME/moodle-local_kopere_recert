{{!
    @template recerttask_coursecompletion/history

    Example context (json):
    {}
}}

<div>
    <h5>{{#str}}historytitle, recerttask_coursecompletion{{/str}}</h5>
    {{#hascompletion}}<p>{{#str}}enrolledat, recerttask_coursecompletion{{/str}}: {{timeenrolled}}</p><p>{{#str}}startedat, recerttask_coursecompletion{{/str}}: {{timestarted}}</p><p>{{#str}}completedat, recerttask_coursecompletion{{/str}}: {{timecompleted}}</p>{{/hascompletion}}
    {{#hasgrade}}<p>{{#str}}finalgrade, recerttask_coursecompletion{{/str}}: {{grade}}</p>{{/hasgrade}}
    <table class="generaltable"><thead><tr><th>{{#str}}criterion, recerttask_coursecompletion{{/str}}</th><th>{{#str}}completion, recerttask_coursecompletion{{/str}}</th><th>{{#str}}grade, recerttask_coursecompletion{{/str}}</th></tr></thead><tbody>{{#criteria}}<tr><td>{{criteriaid}}</td><td>{{timecompleted}}</td><td>{{gradefinal}}</td></tr>{{/criteria}}</tbody></table>
</div>
