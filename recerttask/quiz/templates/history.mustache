{{!
    @template recerttask_quiz/history

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}

<div class="recerttask-quiz-history">
    <h5>{{quizname}}</h5>
    <p>{{attemptcount}} {{#str}}attempts, recerttask_quiz{{/str}}</p>
    {{#hasfinalgrade}}<p>{{#str}}finalgrade, recerttask_quiz{{/str}}: <strong>{{finalgrade}}</strong> / {{maxgrade}}</p>{{/hasfinalgrade}}
    <table class="generaltable">
        <thead><tr><th>{{#str}}attempt, recerttask_quiz{{/str}}</th><th>{{#str}}state, recerttask_quiz{{/str}}</th><th>{{#str}}start, recerttask_quiz{{/str}}</th><th>{{#str}}finish, recerttask_quiz{{/str}}</th><th>{{#str}}grade, recerttask_quiz{{/str}}</th></tr></thead>
        <tbody>{{#attempts}}<tr><td>{{attempt}}</td><td>{{state}}</td><td>{{timestart}}</td><td>{{timefinish}}</td><td>{{#hasgrade}}{{grade}}{{/hasgrade}}</td></tr>{{/attempts}}</tbody>
    </table>
</div>
