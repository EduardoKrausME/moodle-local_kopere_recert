{{!
    @template recerttask_forum/history

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}

<div class="recerttask-forum-history">
    <h5>{{forumname}}</h5>
    <p>{{discussioncount}} {{#str}}discussions, recerttask_forum{{/str}}, {{postcount}} {{#str}}posts, recerttask_forum{{/str}}</p>
    {{#posts}}
    <article class="mb-3">
        <h6>{{discussionname}} — {{subject}}</h6>
        <div class="text-muted">{{created}}</div>
        <div>{{{message}}}</div>
    </article>
    {{/posts}}
</div>
